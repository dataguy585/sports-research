[Unit]
Description=MarketEdge NFL efficiency data refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cory
WorkingDirectory=/home/cory/sports-research

ExecStart=/usr/bin/flock -w 300 /tmp/marketedge-nfl-efficiency.lock /home/cory/sports-research/.venv/bin/python -m collectors.nfl_efficiency

[Install]
WantedBy=multi-user.target
